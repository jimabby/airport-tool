# Dependencies
node_modules/

# Generated client configs (may contain credentials)
config-gen/output/

# Your real server details — contains proxy secrets and the subscription token.
# Never commit these.
config-gen/server.json
config-gen/servers.json

# Test sandbox produced by server/test-setup.sh
server/.sandbox/
server/.sandbox.*/

# Logs / env
*.log
.env

# Probe history and monitor state, written beside the store at runtime.
config-gen/test-history.json
config-gen/monitor-state.json

# The dashboard's self-signed TLS pair (TLS_SELFSIGNED=1) — ui-key.pem is a
# private key, and it lands next to servers.json rather than anywhere obvious.
config-gen/ui-cert.pem
config-gen/ui-key.pem

# A write that died between the temp file and the rename leaves this behind,
# and it holds every credential the store does.
config-gen/*.tmp
# gen.js --export / the dashboard backup download, if saved into the repo.
config-gen/backup*.json
