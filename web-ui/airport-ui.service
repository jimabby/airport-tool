# Airport Tool dashboard as a system service.
#
# Without this the dashboard — and with it the background health monitor —
# exists only while someone leaves `npm start` running in a terminal. A monitor
# that stops when you close the laptop lid cannot tell you a server went down.
#
# Install with web-ui/install-service.sh, or by hand:
#   sudo cp airport-ui.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now airport-ui
#
# Edit User, WorkingDirectory and ReadWritePaths to match your machine.
#
# Your own settings (UI_TOKEN, HOST, TLS_SELFSIGNED, BACKUP_KEY, CFG_PATH, …) go
# in /etc/airport-ui.env, not here: install-service.sh regenerates this file on
# every run, but creates the env file once and never overwrites it — and it is
# 0600 root, where this unit is readable by every account on the machine.
# Values in it override the Environment= defaults below.

[Unit]
Description=Airport Tool dashboard and health monitor
Documentation=https://github.com/your/airport-tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Never root: this reads and rewrites a file full of proxy credentials, and it
# only ever needs to be the user that owns servers.json.
User=REPLACE_USER
Group=REPLACE_GROUP
WorkingDirectory=REPLACE_DIR
ExecStart=REPLACE_NODE server.js
Restart=on-failure
RestartSec=5

# Defaults. Bind to loopback unless you mean otherwise: HOST=0.0.0.0 (set in the
# env file) exposes the dashboard to your whole LAN, at which point UI_TOKEN and
# TLS_SELFSIGNED stop being optional.
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=NODE_ENV=production
# Everything you set yourself. The leading "-" lets the unit start before the
# file exists. Example contents (see install-service.sh for the full template):
#   UI_TOKEN=at-least-16-random-characters
#   TLS_SELFSIGNED=1
#   SINGBOX_BIN=/usr/local/bin/sing-box
#   BACKUP_KEY=base64-32-byte-key
EnvironmentFile=-/etc/airport-ui.env

# The service needs its own files and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# ProtectSystem=strict makes everything read-only except what is listed here.
# The store, its .backups/ snapshots, its backup key, the self-signed TLS
# certificate, dashboard-url.txt, the probe history and monitor-state.json all
# live beside CFG_PATH (or at HISTORY_PATH / MONITOR_STATE_PATH), so each of
# those directories has to be listed — space-separated, quoted. config-gen/ is
# the default store's home. install-service.sh adds the directories of CFG_PATH,
# HISTORY_PATH and MONITOR_STATE_PATH from the env file; if you change one of
# them later, re-run it (or add the directory here by hand), or every save fails
# with EROFS. The dashboard names this setting at boot when it cannot write.
ReadWritePaths=REPLACE_RWPATHS
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
